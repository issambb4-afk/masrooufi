import 'dart:convert';
import 'dart:io';

import 'package:csv/csv.dart';
import 'package:masrooufi/data/database/app_database.dart';
import 'package:masrooufi/data/services/preferences_service.dart';
import 'package:masrooufi/domain/repositories/account_repository.dart';
import 'package:masrooufi/domain/repositories/budget_repository.dart';
import 'package:masrooufi/domain/repositories/category_repository.dart';
import 'package:masrooufi/domain/repositories/recurring_rule_repository.dart';
import 'package:masrooufi/domain/repositories/transaction_repository.dart';
import 'package:masrooufi/features/backup/domain/models/backup_data.dart';
import 'package:masrooufi/features/backup/domain/repositories/backup_repository.dart';
import 'package:path_provider/path_provider.dart';

class BackupRepositoryImpl implements BackupRepository {
  final TransactionRepository transactionRepo;
  final CategoryRepository categoryRepo;
  final AccountRepository accountRepo;
  final BudgetRepository budgetRepo;
  final RecurringRuleRepository recurringRepo;
  final AppDatabase database;
  final PreferencesService prefs;

  BackupRepositoryImpl({
    required this.transactionRepo,
    required this.categoryRepo,
    required this.accountRepo,
    required this.budgetRepo,
    required this.recurringRepo,
    required this.database,
    required this.prefs,
  });

  @override
  Future<File> createBackup() async {
    final transactions = await transactionRepo.getAllTransactions();
    final categories = await categoryRepo.getAllCategories();
    final accounts = await accountRepo.getAllAccounts();
    final budgets = await budgetRepo.getAllBudgets();
    final recurringRules = await recurringRepo.getAllRecurringRules();

    final data = BackupData(
      backupVersion: 1,
      createdAt: DateTime.now().toIso8601String(),
      currency: prefs.getDefaultCurrency(),
      transactions: transactions,
      categories: categories,
      accounts: accounts,
      budgets: budgets,
      recurringRules: recurringRules,
    );

    final jsonString = jsonEncode(data.toJson());
    final dir = await getApplicationDocumentsDirectory();
    final file = File('${dir.path}/masrooufi_backup_${DateTime.now().millisecondsSinceEpoch}.json');
    await file.writeAsString(jsonString);
    return file;
  }

  @override
  Future<void> restoreBackup(File file) async {
    final jsonString = await file.readAsString();
    final Map<String, dynamic> jsonMap = jsonDecode(jsonString);
    final backupData = BackupData.fromJson(jsonMap);

    await database.transaction(() async {
      // Clear current data
      await database.delete(database.transactionsTable).go();
      await database.delete(database.categoriesTable).go();
      await database.delete(database.accountsTable).go();
      await database.delete(database.budgetsTable).go();
      await database.delete(database.recurringRulesTable).go();

      // Insert backup data
      for (var a in backupData.accounts) {
        await accountRepo.createAccount(a);
      }
      for (var c in backupData.categories) {
        await categoryRepo.createCategory(c);
      }
      for (var b in backupData.budgets) {
        await budgetRepo.createBudget(b);
      }
      for (var r in backupData.recurringRules) {
        await recurringRepo.createRecurringRule(r);
      }
      for (var t in backupData.transactions) {
        await transactionRepo.createTransaction(t);
      }
    });

    await prefs.setDefaultCurrency(backupData.currency);
  }

  @override
  Future<File> createCsvExport() async {
    final transactions = await transactionRepo.getAllTransactions();
    final categories = await categoryRepo.getAllCategories();
    final accounts = await accountRepo.getAllAccounts();

    List<List<dynamic>> rows = [];
    rows.add(['ID', 'Date', 'Type', 'Amount (Minor Units)', 'Currency', 'Account', 'Category', 'Note', 'Created At']);

    for (var tx in transactions) {
      final accName = accounts.where((a) => a.id == tx.accountId).firstOrNull?.name ?? 'Unknown';
      final catName = categories.where((c) => c.id == tx.categoryId).firstOrNull?.name ?? 'Unknown';

      rows.add([
        tx.id,
        tx.transactionDate.toIso8601String(),
        tx.type,
        tx.amount,
        prefs.getDefaultCurrency(),
        accName,
        catName,
        tx.note ?? '',
        tx.createdAt.toIso8601String()
      ]);
    }

    String csv = const ListToCsvConverter().convert(rows);
    final dir = await getApplicationDocumentsDirectory();
    final file = File('${dir.path}/masrooufi_export_${DateTime.now().millisecondsSinceEpoch}.csv');
    await file.writeAsString(csv);
    return file;
  }
}
